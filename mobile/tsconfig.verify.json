{
  "$comment": "Compiles the pure date utilities and their checks to CommonJS so they can run under plain `node`, without Metro or a React Native runtime. Kept separate from tsconfig.json because it targets Node, not the app, and must not pull React Native types into the output.",
  "compilerOptions": {
    "strict": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2020",
    "lib": ["es2020"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": ".tmp/verify",
    "rootDir": "..",
    "types": ["node"]
  },
  "files": [
    "src/utils/dateCalc.ts",
    "src/utils/format.ts",
    "src/utils/academicYear.ts",
    "src/utils/masterGridCalendar.ts",
    "src/utils/masterGridHeadings.ts",
    "src/utils/letterPreview.ts",
    "src/utils/cccMatrix.ts",
    "src/utils/clinicRotationRequest.ts",
    "src/utils/capacityRules.ts",
    "src/utils/noticeDispatch.ts",
    "src/utils/networkDiagram.ts",
    "scripts/verify-date-calc.ts",
    "scripts/verify-date-boundaries.ts",
    "scripts/verify-date-normalize.ts",
    "scripts/verify-master-grid-headings.ts",
    "scripts/verify-letter-preview.ts",
    "scripts/verify-ccc-matrix.ts",
    "scripts/verify-clinic-rotation-request.ts",
    "scripts/verify-capacity.ts",
    "scripts/verify-notice-dispatch.ts",
    "scripts/verify-network-diagram.ts",
    "../scripts/date-parity-cases.js"
  ]
}
