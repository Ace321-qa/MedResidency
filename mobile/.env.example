# Mobile environment
#
# Copy to `.env` and adjust. Only variables prefixed with EXPO_PUBLIC_ are
# readable by the app bundle, so never put a database password or any other
# secret here — this app talks to the Node.js API over HTTP, and the API is the
# only thing that holds credentials.
#
#   cp .env.example .env
#
# Restart the dev server after changing this file: EXPO_PUBLIC_ values are
# inlined at bundle time, not read at runtime.

# Base URL of the Node.js API, including the /api/v1 prefix.
#
#   iOS simulator / Expo Go on the same machine  -> http://localhost:5001/api/v1
#   Android emulator (AVD)                       -> http://10.0.2.2:5001/api/v1
#   Physical device on the same Wi-Fi            -> http://<your-lan-ip>:5001/api/v1
#
# When unset, src/config/env.ts falls back to localhost:5001 and rewrites the
# host to 10.0.2.2 automatically on Android emulators.
EXPO_PUBLIC_API_URL=http://localhost:5001/api/v1

# Used only before anyone has signed in, and as a last-resort default.
# In the shipped flow the resident and programme ids come from the sign-in
# screen, which reads the real roster from the API.
EXPO_PUBLIC_FALLBACK_RESIDENT_ID=1
EXPO_PUBLIC_FALLBACK_PROGRAM_ID=1