# Local HTTP port. src/server.js falls back to 5000 only when this is unset.
PORT=5001
NODE_ENV=development

# Hostinger MySQL Database Credentials
# DB_PASS is read first; DB_PASSWORD is accepted as a fallback alias.
DB_HOST=your_hostinger_mysql_host
DB_USER=your_hostinger_mysql_user
DB_PASS=your_hostinger_mysql_password
DB_NAME=u531054669_MedResidency
DB_PORT=3306

# Optional pool tuning (defaults shown)
# DB_POOL_SIZE=10
# DB_CONNECT_TIMEOUT=10000
